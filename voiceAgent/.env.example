PORT=3001
# Local: set your public HTTPS tunnel URL, with no trailing path.
# Render: leave unset; RENDER_EXTERNAL_URL is used automatically.
PUBLIC_BASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
CONTROLLER_MODEL=gpt-5.4-mini

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional default destination for npm run call.
CFO_PHONE_NUMBER=

# Without ElevenLabs credentials, Twilio's built-in voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# The CFO hears the holding message while the agents work within this budget.
TURN_TIMEOUT_MS=35000
SESSION_TTL_MS=1800000
MAX_CONCURRENT_CALLS=100

# Optional PRISM model traces: metadata only, no prompts or spoken answers.
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://prism-api-prod.up.railway.app
